{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harbor",
  "version": "0.0.2",
  "identifier": "dev.harbor.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "bar",
        "title": "Harbor Bar",
        "width": 1200,
        "height": 30,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "dock",
        "title": "Harbor Dock",
        "width": 480,
        "height": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": true
      },
      {
        "label": "widgets",
        "title": "Harbor Widgets",
        "width": 420,
        "height": 780,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "Harbor Settings",
        "width": 560,
        "height": 720,
        "minWidth": 460,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMzRCRDYzMDczMDk5NzYKUldSMm1UQUhZNzAwb2laMTRTUlFQc1MyN3ZFZFZpWVV1NWN4Vi9acnZwaHd2a25QekFjMUFRc1cK",
      "endpoints": [
        "https://github.com/mhilmisyarif/harbor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
