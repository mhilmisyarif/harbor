{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for Harbor's windows",
  "windows": [
    "bar",
    "dock",
    "widgets",
    "settings",
    "card",
    "preview"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "autostart:default",
    "dialog:allow-open",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ]
}
